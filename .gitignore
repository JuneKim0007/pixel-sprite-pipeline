# Vendored ComfyUI checkout and its multi-gigabyte weights. Reinstallable,
# and 21 of this project's 21 GB live here.
ComfyUI/

# Derived. Runs are reproducible from their manifest; keeping them would
# make every generation a commit.
out/

# Operational state, not source. The queue examples are, and git cannot
# re-include a path whose parent directory is excluded — hence the /* form.
var/*
!var/queue/
var/queue/*
!var/queue/examples/

# Reference art. Local only - these are source images, not code, and a
# public repo has no business redistributing them.
library/refs/

.run/

__pycache__/
*.py[cod]
.DS_Store
.ruff_cache/

# Mirrored side references cached beside their source.
*__mirror.png
